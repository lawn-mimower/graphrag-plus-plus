# Google GenAI API Key
# Get your API key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_api_key_here

# Optional: Logging Configuration
LOG_LEVEL=INFO

# Optional: Override default thresholds
# RSWOOSH_SIMILARITY_THRESHOLD=0.85
# SPLINK_MATCH_PROBABILITY_THRESHOLD=0.8
# TOPOLOGICAL_JACCARD_THRESHOLD=0.7
# SEMANTIC_SIMILARITY_THRESHOLD=0.9

# Optional: Override Gemini model names
# GEMINI_MODEL_HEAVY=gemini-2.5-flash       # extraction, query planning, summaries
# GEMINI_MODEL_LIGHT=gemini-2.5-flash-lite
# GEMINI_MODEL_DEDUP=gemini-2.5-pro         # full-context LLM deduplication
